# Atlas environment template. Copy to `.env` and fill in real keys.
# All keys stay server-side (read in process.env only inside server-only
# modules) and are never sent to the client or logged.

# Meta Model API — the AI provider for chat turns (muse-spark-1.3),
# audio turns (muse-spark-1.2), and the video channels on the Responses
# endpoint. Used only by server-side model calls; never expose in the browser.
# Create a key in the Model API dashboard once you have access.
MODEL_API_KEY=

# Exa API key — used only by server-side web search (the websearch/webfetch
# tools). Never expose this in the browser.
EXA_API_KEY=

